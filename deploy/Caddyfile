# HTTPS automatico (Let's Encrypt) para el dominio. La app web y el API van en el mismo dominio.
{$DOMINIO} {
	encode zstd gzip

	# Sin usuario/clave compartidos: cada persona inicia sesion en la app (DNI + contrasena) y el API
	# exige su token. La app web (archivos estaticos) es publica; los datos solo salen con sesion.

	# fotos de evidencia de hasta 10 MB (el backend rechaza lo mayor)
	request_body {
		max_size 15MB
	}

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /instalacion/* {
		reverse_proxy backend:8080
	}
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# la app nueva se toma al recargar; los recursos con hash se cachean
		@sinCache path / /index.html /flutter_service_worker.js /flutter_bootstrap.js /version.json /manifest.json
		header @sinCache Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
