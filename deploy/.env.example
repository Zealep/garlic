# Copiar como .env en el servidor (nunca subir el .env al repositorio)

# Dominio: subdominio de la web de la empresa (registro DNS tipo A hacia la IP del droplet),
# ej. compras.agroguadalupe.com. Para pruebas sin DNS: la IP con sslip.io (147.182.182.133.sslip.io).
DOMINIO=compras.agroguadalupe.com

# Empresa del cliente (la instalacion solo atiende a esta empresa)
EMPRESA_RUC=20614219824
EMPRESA_RAZON_SOCIAL=AGROEXPORTADORA GUADALUPE S.A.C.
CAMPANIA=2026

# Primer usuario: administrador. Entra con su DNI y esta clave temporal; al entrar se le pide cambiarla.
# Desde la app (menu de cuenta > Usuarios) crea a los evaluadores.
ADMIN_NOMBRE=Nombre Apellido
ADMIN_DNI=00000000
ADMIN_EMAIL=
ADMIN_CLAVE_INICIAL=cambiar-esta-clave

# Firma de las sesiones (>= 32 caracteres): openssl rand -base64 48
# Si se cambia, todos deben volver a iniciar sesion.
JWT_SECRET=reemplazar-por-una-clave-larga-y-aleatoria

# Clave de la base de datos (larga y aleatoria: openssl rand -base64 24)
DB_PASSWORD=cambiar-por-una-clave-larga
