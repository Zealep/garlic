# Copiar como .env en el servidor (nunca subir el .env al repositorio)

# Dominio: propio (garlic.midominio.com) o, para empezar, la IP con sslip.io: 164-90-12-34.sslip.io
DOMINIO=164-90-12-34.sslip.io

# Empresa del cliente (la instalacion solo atiende a esta empresa)
EMPRESA_RUC=20123456789
EMPRESA_RAZON_SOCIAL=AGROEXPORTADORA DEL CLIENTE S.A.C.
CAMPANIA=2026

# Primer usuario (aparece como evaluador en la app)
ADMIN_NOMBRE=Nombre Apellido
ADMIN_EMAIL=correo@empresa.pe

# Clave de la base de datos (larga y aleatoria: openssl rand -base64 24)
DB_PASSWORD=cambiar-por-una-clave-larga

# Acceso al sitio (usuario y clave que se comparten con el cliente)
# El hash se genera con: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'la-clave'
# En este archivo, cada $ del hash se escribe $$ (docker compose lo exige).
ACCESO_USUARIO=garlic
ACCESO_HASH=$$2a$$14$$reemplazar-por-el-hash
